{"header":"<h1>Module <code><span>S.Ext</span></code></h1>","type":"documentation","uses_katex":false,"breadcrumbs":[{"name":"Index","href":"../../../../../../index.html","kind":"leaf-page"},{"name":"soteria","href":"../../../../../index.html","kind":"page"},{"name":"Soteria","href":"../../../../index.html","kind":"module"},{"name":"Bv_values","href":"../../../index.html","kind":"module"},{"name":"Typed","href":"../../index.html","kind":"module"},{"name":"S","href":"../index.html","kind":"module-type"},{"name":"Ext","href":"#","kind":"module"}],"toc":[],"source_anchor":null,"preamble":"","content":"<div class=\"odoc-spec\"><div class=\"spec type subst anchored\" id=\"type-{super_t}4/shadowed/(62a161c9406acb286636f36b354f7e5b)\"><a href=\"#type-{super_t}4/shadowed/(62a161c9406acb286636f36b354f7e5b)\" class=\"anchor\"></a><code><span><span class=\"keyword\">type</span> <span>('ghost, 't, 'ty) {super_t}4/shadowed/(62a161c9406acb286636f36b354f7e5b)</span></span><span> :=\u000A  <span><span>(<span class=\"type-var\">'ghost</span>, <span class=\"type-var\">'t</span>, <span class=\"type-var\">'ty</span>)</span> <a href=\"../../../Svalue/index.html#type-t\">Bv_values.Svalue.t</a></span></span></code></div><div class=\"spec-doc\"><p><code>_ super_t</code> is the enclosing svalue</p></div></div><div class=\"odoc-spec\"><div class=\"spec type subst anchored\" id=\"type-{super_ty}5/shadowed/(62a161c9406acb286636f36b354f7e5b)\"><a href=\"#type-{super_ty}5/shadowed/(62a161c9406acb286636f36b354f7e5b)\" class=\"anchor\"></a><code><span><span class=\"keyword\">type</span> <span>'ty {super_ty}5/shadowed/(62a161c9406acb286636f36b354f7e5b)</span></span><span> :=\u000A  <span><span class=\"type-var\">'ty</span> <a href=\"../../../Svalue/index.html#type-ty\">Bv_values.Svalue.ty</a></span></span></code></div><div class=\"spec-doc\"><p><code>_ super_ty</code> is the enclosing svalue type</p></div></div><div class=\"odoc-spec\"><div class=\"spec type anchored\" id=\"type-t\"><a href=\"#type